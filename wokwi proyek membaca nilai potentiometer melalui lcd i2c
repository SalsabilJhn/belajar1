#include <LCD_I2C.h>
LCD_I2C lcd(0x27, 16, 2);
#define tombol1 5
#define tombol2 4
#define tombol3 3
#define tombol4 2
#define statustombol0 digitalRead(tombol1)
#define statustombol1 digitalRead(tombol2)
#define statustombol2 digitalRead(tombol3)
#define statustombol3 digitalRead(tombol4)
int tekanan;
char buff[10];

void setup() {
 pinMode(tombol1, INPUT_PULLUP);
 pinMode(tombol2, INPUT_PULLUP);
 pinMode(tombol3, INPUT_PULLUP);
 pinMode(tombol4, INPUT_PULLUP); 
 lcd.begin();
 lcd.backlight(); 
}

void loop() {
 if(tekanan == 0) {
  lcd.setCursor(3, 0);
  lcd.print("tekan SW0");
  if(statustombol0 == 0){
    lcd.clear();
    tekanan = 1;
    delay(300);
  }
 }
 if(tekanan == 1) {
  lcd.setCursor(0, 0);
  lcd.print(">ADC-A0"); 
  lcd.setCursor(0, 1);
  lcd.print(" ADC-A1");
   if(statustombol0 == 0) {
   lcd.clear();
   tekanan = 3;
   delay(300);
   }
   if(statustombol3 == 0) {
   lcd.clear();
   tekanan = 0;
   delay(300);
   }
   if(statustombol1 == 0) {
   lcd.clear();
   tekanan = 2;
   delay(300);
   }
  }
 if(tekanan == 2) {
  lcd.setCursor(0, 0);
  lcd.print(" ADC-A0");
  lcd.setCursor(0, 1);
  lcd.print(">ADC-A1");
   if(statustombol2 == 0) {
    lcd.clear();
    tekanan = 1;
    delay(300);
   }
   if(statustombol3 == 0) {
    lcd.clear();
    tekanan = 0;
    delay(300);
   }
   if(statustombol0 == 0) {
    lcd.clear();
    tekanan = 4;
    delay(300);
   }
  }
 if(tekanan == 3){
  lcd.setCursor(2, 0);
  lcd.print("Nilai ADC-A0");
  lcd.setCursor(6, 1);
  sprintf(buff, "%4d", analogRead(A6));
  lcd.print(buff);
   if(statustombol3 == 0) {
    lcd.clear();
    tekanan = 1;
    delay(300);
   }
 }
 if(tekanan == 4){
  lcd.setCursor(2, 0);
  lcd.print("Nilai ADC-A1");
  lcd.setCursor(6, 1);
  sprintf(buff, "%4d", analogRead(A7));
  lcd.print(buff);
   if(statustombol3 == 0) {
   lcd.clear();
   tekanan = 2;
   delay(300);
   }
 }
}

