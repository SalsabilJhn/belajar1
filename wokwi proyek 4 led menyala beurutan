#define led1 5
#define led2 4
#define led3 3
#define led4 2
#define tombol1 6
#define statustombol1 digitalRead(tombol1)
int pencet;

void setup() {
pinMode(led1, OUTPUT);
pinMode(led2, OUTPUT);
pinMode(led3, OUTPUT);
pinMode(led4, OUTPUT);
pinMode(tombol1, INPUT_PULLUP);
}

void loop() {
if(statustombol1 == 0) {
  pencet++; // VARIABEL PERTAMBAHAN LED
  delay(200);
  if(pencet == 5) { // LED RESET, MATI
    pencet = 0;
  }
}
if(pencet == 0 ) { //SEMUA LED MATI
  digitalWrite(led1, 0);
  digitalWrite(led2, 0);
  digitalWrite(led3, 0);
  digitalWrite(led4, 0);
}
if(pencet == 1 ) { //LED 1 MENYALA
  digitalWrite(led1, 1);
  digitalWrite(led2, 0);
  digitalWrite(led3, 0);
  digitalWrite(led4, 0);
}
if(pencet == 2 ) { // LED 2 MENYALA
  digitalWrite(led1, 0);
  digitalWrite(led2, 1);
  digitalWrite(led3, 0);
  digitalWrite(led4, 0);
}
if(pencet == 3 ) { // LED 3 MENYALA
  digitalWrite(led1, 0);
  digitalWrite(led2, 0);
  digitalWrite(led3, 1);
  digitalWrite(led4, 0);
}
if(pencet == 4 ) { // LED 4 MENYALA
  digitalWrite(led1, 0);
  digitalWrite(led2, 0);
  digitalWrite(led3, 0);
  digitalWrite(led4, 1);
}
}
